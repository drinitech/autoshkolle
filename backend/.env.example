# NeonDB — krijo dy branch-e (production / development), vendos pgbouncer=true për pooled connections
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/autoshkolle?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/autoshkolle?sslmode=require"

JWT_SECRET="ndrysho-me-nje-string-te-gjate-random"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Për cron notifications (opsionale)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
